PORT=3333
DATABASE_URL=postgres://usuario:senha@localhost:5432/meu_controle_financeiro
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
SESSION_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
# COOKIE_DOMAIN=

# V2.4 — segurança avançada
# Gere com: openssl rand -hex 32
MFA_ENCRYPTION_KEY=gere_uma_chave_hexadecimal_de_64_caracteres
PASSWORD_RESET_MINUTES=30
FRONTEND_URL=http://localhost:5173
# Opcional: endpoint de e-mail transacional que aceite {to,type,link,expires_minutes}
EMAIL_WEBHOOK_URL=

# V2.5 — armazenamento privado de anexos
UPLOAD_DIR=./private-uploads
MAX_UPLOAD_BYTES=10485760

# V2.6 — PostgreSQL/produção
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=/run/secrets/postgres-ca.pem
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
BACKUP_RETENTION_DAYS=30
